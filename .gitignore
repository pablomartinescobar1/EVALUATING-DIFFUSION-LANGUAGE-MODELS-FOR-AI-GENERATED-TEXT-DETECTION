# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Extracted features (regenerated by scripts/run_experiment.py) -- never committed,
# large and fully derivable from the datasets + models, not the point of the repo.
results/features/*
!results/features/.gitkeep

# Table outputs ARE committed -- they're the actual numbers the paper cites. Ad hoc /
# throwaway runs (smoke tests with a tiny n_total, etc.) should be named with a
# leading "_" by convention (e.g. _smoke_beemo.csv) so they stay untracked here.
results/tables/_*.csv

# Model/dataset caches
.cache/
*.log
